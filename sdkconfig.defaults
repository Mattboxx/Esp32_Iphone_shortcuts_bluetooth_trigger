# ============================================================
#  ESP32 BT Trigger - common settings (all chips)
#  Chip-specific Bluetooth settings: sdkconfig.defaults.<chip>
# ============================================================

CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y

# Custom partition table with the "btcfg" settings partition
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 2 MB flash header + DIO mode: boots on every 2/4/8/16 MB board
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# Smaller, quieter build
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
